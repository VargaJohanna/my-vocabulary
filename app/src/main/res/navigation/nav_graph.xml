<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/dictionaryListFragment"
        android:name="com.vocabulary.myvocabulary.ui.dictionaries.DictionaryListFragment"
        android:label="fragment_dictionary_list"
        tools:layout="@layout/fragment_dictionary_list">
        <action
            android:id="@+id/action_dictionary_to_wordList"
            app:destination="@id/wordListFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim">
            <argument
                android:name="dictionaryId"
                app:argType="long" />
            <argument
                android:name="dictonaryName"
                app:argType="string" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/quizListFragment"
        android:name="com.vocabulary.myvocabulary.ui.quizzes.QuizListFragment"
        android:label="fragment_quiz_list"
        tools:layout="@layout/fragment_quiz_list" >
        <action
            android:id="@+id/to_dictionaryPickerFragment"
            app:destination="@id/dictionaryPickerFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim">
            <argument
                android:name="quizType"
                app:argType="integer" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.vocabulary.myvocabulary.ui.home.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_dictionaryListFragment"
            app:destination="@id/dictionaryListFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim" />
        <action
            android:id="@+id/action_homeFragment_to_quizListFragment"
            app:destination="@id/quizListFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim" />
    </fragment>
    <fragment
        android:id="@+id/wordListFragment"
        android:name="com.vocabulary.myvocabulary.ui.words.WordListFragment"
        android:label="WordListFragment"
        tools:layout="@layout/fragment_word_list">
        <argument
            android:name="dictionaryId"
            app:argType="long" />
        <argument
            android:name="dictonaryName"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/dictionaryPickerFragment"
        android:name="com.vocabulary.myvocabulary.ui.quizzes.DictionaryPickerFragment"
        android:label="DictionaryPickerFragment"
        tools:layout="@layout/fragment_choose_dictionary">
        <argument
            android:name="quizType"
            app:argType="integer" />
        <action
            android:id="@+id/action_dictionaryPickerFragment_to_quizFragment"
            app:destination="@id/quizFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim">
            <argument
                android:name="dictionaryId"
                app:argType="long" />
            <argument
                android:name="quizOption"
                app:argType="integer" />
            <argument
                android:name="quizType"
                app:argType="integer" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/quizFragment"
        android:name="com.vocabulary.myvocabulary.ui.quizzes.QuizFragment"
        android:label="QuizFragment"
        tools:layout="@layout/fragment_quiz">
        <argument
            android:name="dictionaryId"
            app:argType="long" />
        <argument
            android:name="quizOption"
            app:argType="integer" />
        <argument
            android:name="failedOnly"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="quizType"
            app:argType="integer" />
        <action
            android:id="@+id/to_resultFragment"
            app:destination="@id/resultFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim"
            app:popUpTo="@+id/quizFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="dictionaryId"
                app:argType="long" />
            <argument
                android:name="directionType"
                app:argType="integer" />
            <argument
                android:name="quizType"
                app:argType="integer" />
        </action>
    </fragment>
    <fragment
        android:id="@+id/resultFragment"
        android:name="com.vocabulary.myvocabulary.ui.results.ResultFragment"
        android:label="ResultFragment"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="dictionaryId"
            app:argType="long" />
        <argument
            android:name="directionType"
            app:argType="integer" />
        <argument
            android:name="quizType"
            app:argType="integer" />
        <action
            android:id="@+id/from_result_to_quizListFragment"
            app:destination="@id/quizListFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim"
            app:popUpTo="@+id/quizListFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/from_result_to_quiz"
            app:destination="@id/quizFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/nav_default_enter_anim"
            app:popExitAnim="@anim/nav_default_exit_anim"
            app:popUpTo="@+id/resultFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="dictionaryId"
                app:argType="long" />
            <argument
                android:name="quizOption"
                app:argType="integer" />
            <argument
                android:name="failedOnly"
                app:argType="boolean" />
            <argument
                android:name="quizType"
                app:argType="integer" />
        </action>
    </fragment>
</navigation>