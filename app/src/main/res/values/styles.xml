<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:alertDialogTheme">@style/AlertDialogTheme.Light</item>
        <item name="fontFamily">@font/maven_pro</item>
    </style>

    <style name="AlertDialogTheme.Light" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:buttonBarButtonStyle">
            @style/Widget.MaterialComponents.Button.TextButton.Dialog
        </item>
        <item name="android:background">?attr/colorBackgroundFloating</item>
    </style>

    <style name="MainButtonStyle" parent="AppTheme">
        <item name="colorAccent">@color/colorPrimary</item>
        <item name="android:textColor">@color/primary_light</item>
        <item name="android:textSize">@dimen/text_size_bigger</item>
    </style>

    <style name="ProgressBarStyle">
        <item name="android:layout_marginStart">@dimen/margin_normal</item>
        <item name="android:layout_marginLeft">@dimen/margin_normal</item>
        <item name="android:layout_marginTop">@dimen/margin_normal</item>
        <item name="android:layout_marginBottom">@dimen/margin_normal</item>
        <item name="android:layout_marginRight">@dimen/margin_normal</item>
        <item name="android:foregroundGravity">center</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="ErrorMessage">
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <style name="TitleStyle">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:paddingBottom">@dimen/padding_normal</item>
    </style>

    <style name="TextButton">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textSize">@dimen/text_size_normal</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="QuizCardTextStyle">
        <item name="android:padding">30dp</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:gravity">center</item>
    </style>
    
    <style name="WordDetail">
        <item name="android:textSize">@dimen/text_size_normal</item>
    </style>

    <style name="WordDetailText" parent="WordDetail">
        <item name="android:textStyle">bold</item>
    </style>

</resources>
