<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_fragment_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:titleTextColor="@color/white"
            android:fitsSystemWindows="true"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/my_vocabulary_app_title">

            <ImageButton
                android:id="@+id/about_button"
                android:layout_width="@dimen/information_icon_size"
                android:layout_height="@dimen/information_icon_size"
                android:layout_gravity="end"
                android:background="@null"
                android:elevation="2dp"
                android:padding="@dimen/padding_normal"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_info_outline"
                android:tint="@color/icons" />

            <ImageButton
                android:id="@+id/quote_button"
                android:layout_width="@dimen/information_icon_size"
                android:layout_height="@dimen/information_icon_size"
                android:layout_gravity="end"
                android:background="@null"
                android:elevation="2dp"
                android:padding="@dimen/padding_normal"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_format_quote"
                android:tint="@color/icons"
                android:visibility="invisible" />
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ImageView
        android:id="@+id/dictionary_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_dictionary_background_1000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/quiz_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar" />

    <Button
        android:id="@+id/dictionary_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?selectableItemBackground"
        android:backgroundTint="#00ffffff"
        android:gravity="center"
        android:text="@string/dictionaries_button"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/quiz_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/app_bar" />

    <ImageView
        android:id="@+id/quiz_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_clean_question_button_1000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dictionary_image"
        app:layout_constraintTop_toBottomOf="@id/app_bar" />

    <Button
        android:id="@+id/quiz_button"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?selectableItemBackground"
        android:backgroundTint="#00ffffff"
        android:text="@string/quizzes_button"
        android:textColor="@color/primary_text"
        android:textSize="@dimen/text_size_large"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dictionary_button"
        app:layout_constraintTop_toBottomOf="@+id/app_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>